#!/bin/sh
# Blocks a commit whose STAGED, ADDED lines contain something shaped like a secret.
# The scanner is vendored verbatim from skylark-site (scripts/check-staged-secrets.mjs);
# refresh it by copying that file, never by editing this repo's copy.
# False positive? Append `pragma: allowlist secret` to the offending line.
# Plain relative path on purpose: git runs hooks from the repo root, and the fleet's
# coverage check resolves paths statically (a $(...) substitution reads as unresolvable).
exec node scripts/check-staged-secrets.mjs
